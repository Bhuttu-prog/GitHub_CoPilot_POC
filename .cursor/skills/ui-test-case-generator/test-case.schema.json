{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ui-test-case-catalog.schema.json",
  "title": "UI Test Case Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["module", "feature", "application", "requirements", "testCases"],
  "properties": {
    "$schema": { "type": "string" },
    "module": { "type": "string", "pattern": "^[A-Z0-9]{2,8}$" },
    "feature": { "type": "string", "minLength": 3 },
    "application": { "type": "string", "pattern": "^https?://" },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^REQ-[A-Z0-9]{2,8}-\\d{2}$" },
          "description": { "type": "string", "minLength": 10 }
        }
      }
    },
    "testCases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/testCase" }
    }
  },
  "definitions": {
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "requirementIds",
        "priority",
        "severity",
        "type",
        "technique",
        "tags",
        "preconditions",
        "steps",
        "expectedResult",
        "automation"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^TC-[A-Z0-9]{2,8}-\\d{3}$" },
        "title": { "type": "string", "minLength": 15, "maxLength": 110 },
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^REQ-[A-Z0-9]{2,8}-\\d{2}$" }
        },
        "priority": { "enum": ["P1", "P2", "P3", "P4"] },
        "severity": { "enum": ["Critical", "Major", "Minor", "Trivial"] },
        "type": {
          "enum": ["Functional", "Negative", "Boundary", "UI", "Accessibility", "Security", "End-to-End"]
        },
        "technique": {
          "enum": [
            "Equivalence Partitioning",
            "Boundary Value Analysis",
            "Decision Table",
            "State Transition",
            "Use Case",
            "Error Guessing",
            "Checklist"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^@[a-z0-9-]+$" }
        },
        "preconditions": { "type": "array", "items": { "type": "string", "minLength": 3 } },
        "testData": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array" },
              { "type": "object" }
            ]
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action"],
            "properties": {
              "action": { "type": "string", "minLength": 3 },
              "expected": { "type": "string", "minLength": 3 }
            }
          }
        },
        "expectedResult": { "type": "string", "minLength": 10 },
        "defectId": { "type": "string", "pattern": "^DEF-[A-Z0-9]{2,8}-\\d{3}$" },
        "notes": { "type": "string" },
        "automation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "enum": ["Automated", "Candidate", "Manual"] },
            "spec": { "type": "string", "pattern": "^tests/.+\\.spec\\.ts$" }
          }
        }
      }
    }
  }
}
